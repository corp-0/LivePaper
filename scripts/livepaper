#!/usr/bin/env bash
set -euo pipefail

libexec=${LIVEPAPER_LIBEXEC:-"$HOME/.local/lib/livepaper/current"}
config=${XDG_CONFIG_HOME:-"$HOME/.config"}/livepaper/livepaper.toml

command_name=${1:-run}
if [[ $# -gt 0 ]]; then shift; fi

case "$command_name" in
    run)
        exec "$libexec/LivePaper.Daemon" --config "$config" "$@"
        ;;
    import)
        if [[ $# -ne 1 ]]; then
            echo "usage: livepaper import WALLPAPER_ENGINE_DIRECTORY" >&2
            exit 2
        fi
        exec "$libexec/LivePaper.Daemon" --import-wallpaper "$1"
        ;;
    start|stop|restart|status)
        exec systemctl --user "$command_name" livepaper.service
        ;;
    logs)
        exec journalctl --user -u livepaper.service -f
        ;;
    *)
        echo "usage: livepaper {run|import|start|stop|restart|status|logs}" >&2
        exit 2
        ;;
esac
